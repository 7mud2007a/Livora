# Copy this file to .env (or .env.local) before running `npm run build` or `npm run dev`.
# Only variables that start with PUBLIC_ are made available to the browser bundle.

# The public address of the site, without a trailing slash, e.g. https://www.example.com
# Used for the Open Graph / Twitter preview image (social networks need an absolute URL) and the canonical link.
PUBLIC_SITE_URL=

# Where the contact form sends its message: an HTTPS endpoint that accepts a JSON POST with
#   { "name", "email", "subject", "message", "language" }
# (Formspree-style services and your own serverless function both work.)
# Leave it empty and the form still validates, but tells the visitor honestly that nothing was sent.
PUBLIC_CONTACT_ENDPOINT=
